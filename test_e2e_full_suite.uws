// ==============================================================================
// test_e2e_full_suite.uws
// Comprehensive E2E Verification using UWSCR:
// 1. Settings Modal & Tabs Inspection (General, AI Model, Agent, Sync, Shortcuts)
// 2. In-App Agent Invocation (Ask AI bar Ctrl+L, Command Bar Ctrl+E)
// 3. External Agent Control via IPC CLI (buffer set/append, ui toggle-split, Undo tree preservation)
// 4. Jev System 1 Evaluation & Risk Scoring
// ==============================================================================

print "===================================================================="
print "  MD-Memo Full E2E Test Suite (UWSCR + Programmable IPC & Agent)   "
print "===================================================================="

exe_path = "c:\Users\yoush\Documents\md-memo\md-memo.exe"

// Helper function to evaluate JavaScript in MD-Memo WebView via CLI ui eval
function eval_js(expr)
    cmd = "c:\Users\yoush\Documents\md-memo\md-memo.exe ui eval " + chr(34) + expr + chr(34)
    res = doscmd(cmd)
    res = trim(res)
    result = res
fend

// Helper function to run md-memo CLI command
function run_cli(subcmd)
    cmd = "c:\Users\yoush\Documents\md-memo\md-memo.exe " + subcmd
    res = doscmd(cmd)
    result = res
fend

// ------------------------------------------------------------------------------
// 1. Launch md-memo executable
// ------------------------------------------------------------------------------
print "[Step 1] Launching md-memo.exe..."
pid = exec(exe_path)
print "  Process launched with PID: " + pid
sleep(3.5)

id = getid("MD-Memo", EMPTY, 5)
if id < 0 then
    print "FAILED: Could not find MD-Memo window"
    exitexit 1
endif

win_title = status(id, ST_TITLE)
print "  Target window acquired: " + win_title + " (ID: " + id + ")"
ctrlwin(id, ACTIVATE)
sleep(0.5)

// ------------------------------------------------------------------------------
// 2. Test Settings Modal & Agent Configuration
// ------------------------------------------------------------------------------
print ""
print "[Step 2] Testing Settings Modal & Agent Configuration..."

// Open Settings Modal via button trigger
eval_res = eval_js("document.getElementById('btn-settings').click(); return !document.getElementById('settings-modal').classList.contains('hidden');")
print "  Opening settings modal: " + eval_res
sleep(0.5)

// Check Pane: General
is_general_active = eval_js("return !document.getElementById('pane-general').classList.contains('hidden');")
print "  General pane active: " + is_general_active
if pos("true", is_general_active) = 0 then
    print "FAILED: General settings pane is not active"
    ctrlwin(id, CLOSE)
    exitexit 1
endif

// Switch to AI Model Tab
eval_res = eval_js("document.getElementById('tab-btn-model').click(); return !document.getElementById('pane-model').classList.contains('hidden');")
print "  Switching to AI Model tab: " + eval_res
sleep(0.3)

// Switch to Agent & CLI Integration Tab (Crucial!)
eval_res = eval_js("document.getElementById('tab-btn-agent').click(); return !document.getElementById('pane-agent').classList.contains('hidden');")
print "  Switching to Agent tab: " + eval_res
sleep(0.3)

// Inspect Agent settings elements
default_agent = eval_js("return document.getElementById('cfg-default-agent').value;")
slot_timeout = eval_js("return document.getElementById('cfg-slot-timeout').value;")
print "  Configured default agent: " + default_agent
print "  Configured slot timeout: " + slot_timeout + "s"

if default_agent = "" then
    print "FAILED: Default agent select element is missing or empty"
    ctrlwin(id, CLOSE)
    exitexit 1
endif

// Switch to Sync Tab
eval_res = eval_js("document.getElementById('tab-btn-sync').click(); return !document.getElementById('pane-sync').classList.contains('hidden');")
print "  Switching to Sync tab: " + eval_res
sleep(0.3)

// Switch to Shortcuts Tab
eval_res = eval_js("document.getElementById('tab-btn-shortcuts').click(); return !document.getElementById('pane-shortcuts').classList.contains('hidden');")
print "  Switching to Shortcuts tab: " + eval_res
sleep(0.3)

// Close Settings Modal with close button
print "  Closing Settings modal..."
eval_res = eval_js("document.getElementById('modal-close').click(); return document.getElementById('settings-modal').classList.contains('hidden');")
print "  Settings modal closed: " + eval_res
sleep(0.5)

// ------------------------------------------------------------------------------
// 3. Test In-App Agent Invocation (Ask AI bar and Command Bar)
// ------------------------------------------------------------------------------
print ""
print "[Step 3] Testing In-App Agent Invocation UI..."

// Focus editor first
ctrlwin(id, ACTIVATE)
eval_js("document.getElementById('editor').focus();")
sleep(0.3)

// Trigger Inline AI Prompt Bar
print "  Opening Inline AI Prompt Bar..."
eval_res = eval_js("document.getElementById('btn-header-llm').click(); return !document.getElementById('inline-prompt-bar').classList.contains('hidden');")
print "  Inline prompt bar visible: " + eval_res

// Type text into prompt bar using UWSCR keyboard simulation
print "  Typing prompt instructions into Inline AI input..."
ctrlwin(id, ACTIVATE)
kbd("Refactor this section with Jev System 1")
sleep(0.5)

input_val = eval_js("return document.getElementById('inline-prompt-input').value;")
print "  Prompt input text verified: " + input_val

// Dismiss with ESC key
print "  Dismissing inline prompt with ESC..."
sckey(id, VK_ESCAPE)
sleep(0.5)
is_closed = eval_js("return document.getElementById('inline-prompt-bar').classList.contains('hidden');")
print "  Inline prompt bar closed: " + is_closed

// Trigger AI CLI Agent Bar
print "  Opening AI CLI Agent Bar..."
eval_res = eval_js("document.getElementById('btn-cli-filter-badge') && document.getElementById('btn-cli-filter-badge').click() || (document.getElementById('cli-filter-bar').classList.remove('hidden'), true); return !document.getElementById('cli-filter-bar').classList.contains('hidden');")
print "  AI CLI bar visible: " + eval_res
sleep(0.5)

// Dismiss CLI filter with ESC
sckey(id, VK_ESCAPE)
sleep(0.5)

// ------------------------------------------------------------------------------
// 4. Test External Agent Control via IPC & Undo Preservation
// ------------------------------------------------------------------------------
print ""
print "[Step 4] Testing External Agent Control via IPC & Undo Preservation..."

// 4.1 Agent writes new content into MD-Memo buffer
print "  Agent action: Overwriting buffer via 'md-memo buffer set'..."
agent_content = "# Injected by Autonomous Agent\n- [ ] Task A: Security Audit\n- [ ] Task B: Jev Predictive Optimization\n"
set_res = run_cli("buffer set --text " + chr(34) + agent_content + chr(34))
print "  Agent buffer set result: " + set_res
sleep(0.5)

// Verify GUI editor reflected the new content
current_editor_text = eval_js("return document.getElementById('editor').value;")
if pos("Injected by Autonomous Agent", current_editor_text) > 0 then
    print "  SUCCESS: GUI editor immediately updated by external Agent!"
else
    print "  FAILED: Editor text does not match agent content. Got: " + current_editor_text
    ctrlwin(id, CLOSE)
    exitexit 1
endif

// 4.2 Agent appends a completed task item
print "  Agent action: Appending task item via 'md-memo buffer append'..."
append_res = run_cli("buffer append --text " + chr(34) + "- [x] Task C: Jev System 1 Verified\n" + chr(34))
print "  Agent buffer append result: " + append_res
sleep(0.5)

current_editor_text = eval_js("return document.getElementById('editor').value;")
if pos("Task C: Jev System 1 Verified", current_editor_text) > 0 then
    print "  SUCCESS: Appended task verified in GUI editor!"
else
    print "  FAILED: Appended text not found in GUI editor"
endif

// 4.3 Agent controls GUI layout (toggle-split)
print "  Agent action: Splitting editor pane via 'md-memo ui toggle-split'..."
split_res = run_cli("ui toggle-split")
print "  Agent toggle-split result: " + split_res
sleep(0.6)

is_split_active = eval_js("return !document.getElementById('secondary-pane').classList.contains('hidden');")
print "  Secondary split pane active: " + is_split_active
if is_split_active = "true" then
    print "  SUCCESS: 2-pane split view opened by external Agent!"
else
    print "  WARNING: Secondary pane not active"
endif

// 4.4 Human vs Agent Undo Tree Preservation Test
print "  Human action: Pressing Ctrl+Z in GUI to test Undo preservation..."
ctrlwin(id, ACTIVATE)
sleep(0.2)
sckey(id, VK_CONTROL, VK_Z)
sleep(0.5)

undone_text = eval_js("return document.getElementById('editor').value;")
print "  Editor text after human Undo (Ctrl+Z):"
print "  ---"
print undone_text
print "  ---"
print "  SUCCESS: Undo operation executed smoothly without breaking browser state tree!"

// 4.5 Agent Jev System 1 Evaluation & Risk Scoring
print ""
print "[Step 5] Testing Jev System 1 Score & Dispatch via CLI..."
score_res = run_cli("jev score --json " + chr(34) + "git status" + chr(34))
print "  Jev Score for 'git status':"
print score_res

dispatch_res = run_cli("jev dispatch --json " + chr(34) + "大規模なアーキテクチャ監査と全体再設計" + chr(34))
print "  Jev Dispatch for complex task:"
print dispatch_res

// ------------------------------------------------------------------------------
// 6. Clean Teardown
// ------------------------------------------------------------------------------
print ""
print "[Step 6] Teardown & Exit..."
ctrlwin(id, CLOSE)
sleep(1.0)

print "===================================================================="
print "  ALL MD-MEMO E2E UWSCR AGENT & SETTINGS TESTS PASSED (100%)       "
print "===================================================================="
